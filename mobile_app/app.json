{
  "expo": {
    "name": "Thinkare Patient",
    "slug": "thinkare-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "thinkare",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Thinkare to use your camera to scan clinic QR codes."
        }
      ]
    ],
    "android": {
      "permissions": [
        "CAMERA"
      ]
    }
  }
}
